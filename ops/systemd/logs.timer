# Written by `aso install`: the log cap is checked every {{minutes}} minutes
# while the services run. A missed run is not made up: the next one covers it.
[Unit]
Description=aso: when the service logs are checked against their size cap

[Timer]
OnBootSec={{minutes}}min
OnUnitActiveSec={{minutes}}min
Unit=aso-logs.service

[Install]
WantedBy=timers.target
