<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Written by aso install when redeem.payout is set. It runs the automatic
         redeem every redeem.interval_hours and ends. aso writes its own log
         (aso-redeem.log, with the size cap). -->
    <key>Label</key>
    <string>org.servicepoints.aso-redeem</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{home}}</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>{{exe}}</string>
        <string>--dir</string>
        <string>{{dir}}</string>
        <string>--config</string>
        <string>{{config}}</string>
        <string>redeem</string>
        <string>run</string>
    </array>
    <key>StartInterval</key>
    <integer>{{interval_secs}}</integer>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
